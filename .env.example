# Copie ce fichier en `.env` puis complète les valeurs.

# Base de données.
# Local (SQLite) :
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — pense aussi à passer `provider = "postgresql"`
# dans prisma/schema.prisma et à utiliser l'adaptateur @prisma/adapter-pg :
# DATABASE_URL="postgresql://user:motdepasse@host:5432/rdr?sslmode=require"

# Clé de signature des sessions (obligatoire).
# Génère-la avec : openssl rand -base64 48
AUTH_SECRET=""
