// Schéma de la base RDR Services
// SQLite en développement — bascule vers PostgreSQL en production
// en changeant `provider` ci-dessous et la variable DATABASE_URL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// L'URL de connexion est définie dans prisma.config.ts (Prisma 7).
datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         String    @default("CLIENT") // CLIENT | ADMIN
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings Booking[]
  messages Message[]

  @@map("users")
}

model Booking {
  id          String   @id @default(cuid())
  reference   String   @unique // ex. RDR-2026-0042
  userId      String
  destination String // nom de la destination ou du séjour
  startDate   DateTime
  endDate     DateTime
  travelers   Int      @default(2)
  status      String   @default("DEVIS") // DEVIS | CONFIRME | EN_COURS | TERMINE | ANNULE
  totalCents  Int      @default(0)
  paidCents   Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]
  messages  Message[]

  @@index([userId])
  @@map("bookings")
}

model Document {
  id        String   @id @default(cuid())
  bookingId String
  title     String
  kind      String   @default("AUTRE") // DEVIS | FACTURE | PROGRAMME | VOUCHER | AUTRE
  url       String // chemin ou URL du fichier
  sizeLabel String? // ex. "248 Ko"
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("documents")
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  bookingId String?
  body      String
  fromStaff Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bookingId])
  @@map("messages")
}

// Demandes de devis envoyées depuis le formulaire de contact public
model Lead {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  destination String?
  startDate   String?
  travelers   String?
  budget      String?
  message     String
  status      String   @default("NOUVEAU") // NOUVEAU | CONTACTE | CONVERTI | PERDU
  createdAt   DateTime @default(now())

  @@map("leads")
}
